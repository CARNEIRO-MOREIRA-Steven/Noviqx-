# URL publique du site (SEO : canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://noviqx.fr

# Adresse affichée sur le site. Laisser vide tant que la boîte n'est pas vérifiée :
# aucune adresse n'est alors affichée.
NEXT_PUBLIC_CONTACT_EMAIL=

# Envoi du formulaire (serveur uniquement, jamais exposé au navigateur).
# Service utilisé : Resend (https://resend.com). Le domaine d'envoi doit y être vérifié.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="NOVIQX <contact@noviqx.fr>"
